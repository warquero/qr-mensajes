{
  "name": "qr-mensajes",
  "version": "0.1.0",
  "private": true,
  "description": "Mensajes personalizados (texto, audio o video) detrás de un QR — para talleres de sublimación",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 execute qr-mensajes --local --file=schema.sql",
    "db:remote": "wrangler d1 execute qr-mensajes --remote --file=schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.42.0"
  }
}
